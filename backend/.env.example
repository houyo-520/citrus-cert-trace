# FISCO BCOS 联盟链配置 —— 复制为 .env 并填入真实值（.env 已被 .gitignore 忽略）
#
# 服务器：<your-server-ip>（腾讯云 4核4G）
# 链：FISCO BCOS v3.17.1 单机2节点，chain0/group0，PBFT
# RPC：web3 HTTP 8545（node0）/ 8546（node1）

# 链节点地址：Django 与链同机时用 127.0.0.1；跨机用公网 IP
FISCO_WEB3_RPC=http://127.0.0.1:8545

FISCO_CHAIN_ID=20200
FISCO_GROUP_ID=group0

# CertificateEvidence 存证合约地址（部署后填入）
FISCO_CONTRACT_ADDRESS=

# 存证账户私钥（⚠️ 生产环境务必通过环境变量注入，不要提交到 Git）
FISCO_PRIVATE_KEY=

# 单笔存证交易的 gas 上限
FISCO_GAS_LIMIT=500000

# 是否启用真实上链（false 则全部走模拟存证，便于离线开发）
FISCO_ENABLE_CHAIN=true

# 前端验真页地址（二维码指向）
FRONTEND_VERIFY_BASE=http://localhost:5173/#/verify
