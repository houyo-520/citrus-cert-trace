# ============================================================
# Django 生产化配置
# ============================================================
# ★ 安全默认：不设时 DEBUG=false（生产安全默认，2026-10-07 起）。
#   本地开发需**显式**写 true，否则 DEBUG=false 又没设密钥会拒绝启动。
DJANGO_DEBUG=true

# 允许访问的域名/IP，逗号分隔。★ 不设时默认仅 localhost,127.0.0.1（不再默认 *）。
# 生产必须填具体值，如：
# DJANGO_ALLOWED_HOSTS=<your-server-ip>,localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# 生产环境务必改成随机长字符串（Django 密钥，泄漏会导致会话伪造）
# 生成：python3 -c "import secrets;print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# ============================================================
# FISCO BCOS 联盟链配置 —— 复制为 .env 并填入真实值（.env 已被 .gitignore 忽略）
#
# 服务器：<your-server-ip>（腾讯云 4核4G）
# 链：FISCO BCOS v3.17.1 单机2节点，chain0/group0，PBFT
# RPC：web3 HTTP 8545（node0）/ 8546（node1）
# ============================================================

# 链节点地址：Django 与链同机时用 127.0.0.1；跨机用公网 IP
FISCO_WEB3_RPC=http://127.0.0.1:8545

FISCO_CHAIN_ID=20200
FISCO_GROUP_ID=group0

# CertificateEvidence 存证合约地址（部署后填入）
FISCO_CONTRACT_ADDRESS=

# 存证账户私钥（⚠️ 生产环境务必通过环境变量注入，不要提交到 Git）
FISCO_PRIVATE_KEY=

# 单笔存证交易的 gas 上限
FISCO_GAS_LIMIT=500000

# 是否启用真实上链（false 则全部走模拟存证，便于离线开发）
FISCO_ENABLE_CHAIN=true

# 前端验真页地址（二维码指向）
# 生产：https://trace.example.com/#/verify（trace 子域 = 追溯系统）
# 本地开发：http://localhost:5173/#/verify
FRONTEND_VERIFY_BASE=http://localhost:5173/#/verify

# ============================================================
# 可信存证哈希加盐（Salted Hash，2026-09-26 引入）
# ============================================================
# 存证摘要 = sha256(盐 + 规范化原文)，盐用于抵御彩虹表/字典逆向。
# ⚠️ 生产环境（DJANGO_DEBUG=false）必须设置，否则拒绝启动。
# 生成：python3 -c "import secrets;print(secrets.token_urlsafe(32))"
# ⚠️ 一旦设置并用于存证后不要更改，否则历史哈希全部失配；
#    如确需更改，请运行 `python manage.py rehash_all --apply` 全量重算并重新上链
#    （2026-10-07 起 rehash_all 默认 dry-run，必须显式加 --apply）。
EVIDENCE_SALT=

# 验真接口限流：每个来源 IP 每分钟允许的查询次数（防刷/防拖库）
VERIFY_RATE_LIMIT=30

# ============================================================
# 可信代理 / 客户端 IP 取信（B4）
# ============================================================
# 只有 REMOTE_ADDR 属于 TRUSTED_PROXY_IPS 时，才采信 X-Real-IP / X-Forwarded-For。
# 默认本机（nginx 与 gunicorn 同机）。若 gunicorn 直接对外监听，攻击者可伪造
# 转发头绕限流 —— 保持默认即可挡住直连伪造。
TRUSTED_PROXY_IPS=127.0.0.1,::1
# 可信代理层数（前面有 CDN/多层代理时增大）
TRUSTED_PROXY_HOPS=1

# ============================================================
# OCR 资源上限（M13，防解压炸弹 / 超大 PDF 拖垮 worker）
# ============================================================
OCR_MAX_IMAGE_PIXELS=40000000
OCR_MAX_PDF_PAGES=3
OCR_MAX_PDF_DPI=200
OCR_MAX_PDF_RENDER_PIXELS=40000000
OCR_TIMEOUT_SECONDS=60
